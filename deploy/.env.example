# Premenné ERPNext stacku. Skopíruj do koreňového .env (nie je v gite) a doplň heslá.
ERPNEXT_VERSION=v16.50.0
SITE_NAME=erp.local
HTTP_PORT=8085
# Len písmená a číslice (heslá idú cez shell v create-site).
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Prístup k Portaineru (používa scripts/portainer.ps1)
PORTAINER_URL=http://192.168.1.120:9000
PORTAINER_ENDPOINT_ID=3
PORTAINER_TOKEN=

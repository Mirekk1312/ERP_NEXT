# Premenné ERPNext stacku. Skopíruj do koreňového .env (nie je v gite) a doplň heslá.
ERPNEXT_VERSION=v16.50.0
SITE_NAME=erp.local
HTTP_PORT=8085
# Len písmená a číslice (heslá idú cez shell v create-site).
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# SSH prístup na NAS (používa scripts/nas.ps1)
NAS_HOST=192.168.1.120
NAS_SSH_PORT=22
NAS_USER=
NAS_STACK_DIR=/volume1/docker/erpnext
# Príkaz pre Docker na NAS; ak používateľ nemá prístup k docker.sock, napr. "sudo docker".
NAS_DOCKER=docker
